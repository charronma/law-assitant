# Supabase project (Settings -> API). The anon key is designed to be public,
# but never put the service_role key or the JWT secret in any VITE_* variable.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Backend origin for production builds (no trailing slash). Leave unset in local
# development: Vite proxies /api to localhost:8080. The backend's FRONTEND_URL
# must be set to this site's origin so CORS allows it.
# VITE_API_BASE_URL=https://your-backend.example.com

# Local development without Supabase. Must match AUTH_DISABLED=true on the
# backend. Never enable this in a deployed build.
# VITE_AUTH_DISABLED=true
